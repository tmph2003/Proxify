{
  "manifest_version": 3,
  "name": "Proxify Helper",
  "version": "2.1",
  "description": "Proxify browser helper — 1-Click Proxy Toggle, Custom Request Blocker & DB Capture Controller",
  "permissions": [
    "proxy",
    "activeTab",
    "tabs",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
