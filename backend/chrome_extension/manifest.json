{
  "manifest_version": 3,
  "name": "Proxify Helper",
  "version": "1.1",
  "description": "Proxify browser helper — Facebook cookie extraction & YouTube anti-AFK",
  "permissions": [
    "cookies",
    "activeTab",
    "scripting",
    "tabs",
    "webRequest",
    "webRequestExtraHeaders",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*", "*://facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube_anti_afk.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
