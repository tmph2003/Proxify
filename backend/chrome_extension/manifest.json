{
  "manifest_version": 3,
  "name": "Proxify Helper",
  "version": "2.0",
  "description": "Proxify browser helper — 1-Click Proxy Toggle & DB Capture Controller",
  "permissions": [
    "proxy",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
