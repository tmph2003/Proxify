{
  "manifest_version": 3,
  "name": "Proxify Helper",
  "version": "1.6",
  "description": "Proxify browser helper — 1-Click Proxy Toggle & DB Domain Filter",
  "permissions": [
    "proxy",
    "tabs",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
